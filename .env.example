# Copy this file to .env for local development.
# Generate a secret key with:
# uv run python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# Replace the placeholder below with the generated value.
SECRET_KEY=replace-with-a-random-development-secret-key

# Enable debugging for local development only.
DEBUG=True

# Comma-separated hostnames allowed to serve the application.
ALLOWED_HOSTS=127.0.0.1,localhost
